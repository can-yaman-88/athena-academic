# Copy to .env and fill in. The real .env is gitignored.

# OpenRouter API key — enables the chat agent, PDF engine, note analysis, etc.
OPENROUTER_API_KEY=

# --- Networking (IMPORTANT for remote/server deployments) -------------------
# VITE_API_URL is baked into the frontend at BUILD time, so it must be the address
# the BROWSER can reach the API at. On localhost the defaults are fine; on a server
# set BOTH to the server's IP/domain, then rebuild (docker compose up --build).
#
# Local (default):
#   VITE_API_URL=http://localhost:8888
#   CORS_ORIGINS=http://localhost:8088
# Remote server (example):
#   VITE_API_URL=http://203.0.113.10:8888
#   CORS_ORIGINS=http://203.0.113.10:8088
VITE_API_URL=http://localhost:8888

# Comma-separated origins allowed to call the API (must match the frontend origin).
CORS_ORIGINS=http://localhost:8088
